# Google Cloud
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
CLOUD_TASKS_LOCATION=us-central1
CLOUD_TASKS_QUEUE=lead-followups
CLOUD_RUN_URL=https://your-service.run.app

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Notifications
SALESPERSON_EMAIL=sales@example.com
FROM_EMAIL=noreply@realestate.ai

# Email (SMTP fallback — used if SENDGRID_API_KEY is not set)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Optional: SendGrid (takes priority over SMTP)
SENDGRID_API_KEY=

# Google Calendar
CALENDAR_ID=primary
